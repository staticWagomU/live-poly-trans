{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LivePolyTrans",
  "version": "0.1.0",
  "identifier": "com.staticwagomu.live-poly-trans",
  "build": {
    "beforeDevCommand": "bun run build:helper && bun run dev",
    "beforeBuildCommand": "bun scripts/prepare-dmg-background.mjs && bun run build:helper && bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "LivePolyTrans",
        "label": "main",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/helper"],
    "resources": ["binaries/LivePolyTransHelper.app"],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 760,
          "height": 430
        },
        "appPosition": {
          "x": 165,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 595,
          "y": 220
        }
      }
    }
  }
}
