{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kikimimic",
  "version": "0.1.0",
  "identifier": "com.staticwagomu.kikimimic",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kikimimic",
        "label": "main",
        "width": 980,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "frameworks": ["../target/release/libkkm_translate_ggml.dylib"]
    }
  }
}
